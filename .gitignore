models/cache/
*.task
*.onnx
*.pt
*.pth
*.safetensors
*.ckpt
*.tflite
*.bin
*.engine
*.mlmodel
*.mlpackage

# --- Media & subject recordings (never commit private people) ---
samples/
recordings/
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.m4a
*.flac
# Small licensed test fixtures are allowed explicitly:
!tests/fixtures/**

# --- Built frontend (npm run build writes here; CI/Docker build it) ---
src/lightman/api/static/
frontend/node_modules/
frontend/dist/
frontend/dist-demo/

# --- Analysis outputs ---
output/
runs/
experiments/runs/

# --- Datasets (adapters + manifests are tracked, data is not) ---
datasets/data/

